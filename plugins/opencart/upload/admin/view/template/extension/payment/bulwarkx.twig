{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-bulwarkx" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-bulwarkx" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="bulwarkx_status" id="input-status" class="form-control">
                {% if bulwarkx_status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-api-base-url">{{ entry_api_base_url }}</label>
            <div class="col-sm-10">
              <input type="text" name="bulwarkx_api_base_url" value="{{ bulwarkx_api_base_url }}" placeholder="https://example.com" id="input-api-base-url" class="form-control" />
              {% if error_api_base_url %}
              <div class="text-danger">{{ error_api_base_url }}</div>
              {% endif %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-payee-address">{{ entry_payee_address }}</label>
            <div class="col-sm-10">
              <input type="text" name="bulwarkx_payee_address" value="{{ bulwarkx_payee_address }}" placeholder="0x..." id="input-payee-address" class="form-control" />
              {% if error_payee_address %}
              <div class="text-danger">{{ error_payee_address }}</div>
              {% endif %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-arbiter-address">{{ entry_arbiter_address }}</label>
            <div class="col-sm-10">
              <input type="text" name="bulwarkx_arbiter_address" value="{{ bulwarkx_arbiter_address }}" placeholder="0x..." id="input-arbiter-address" class="form-control" />
              {% if error_arbiter_address %}
              <div class="text-danger">{{ error_arbiter_address }}</div>
              {% endif %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-auto-release">{{ entry_auto_release_seconds }}</label>
            <div class="col-sm-10">
              <input type="number" name="bulwarkx_auto_release_seconds" value="{{ bulwarkx_auto_release_seconds }}" placeholder="86400" id="input-auto-release" class="form-control" min="1" />
              {% if error_auto_release_seconds %}
              <div class="text-danger">{{ error_auto_release_seconds }}</div>
              {% endif %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="bulwarkx_sort_order" value="{{ bulwarkx_sort_order }}" placeholder="0" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
